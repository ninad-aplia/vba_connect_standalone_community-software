# GCP single-VM production env. Copy to deploy/.env.gcp and fill secrets.
# Used by: docker compose -f deploy/docker-compose.gcp.yml --env-file deploy/.env.gcp up -d --build

# --- Domains (point DNS A records to the VM static IP) ---
LOOP_DOMAIN=loop.example.com
MEETNOTE_DOMAIN=meetnote.example.com
MEETNOTE_API_DOMAIN=meetnote-api.example.com
LIVEKIT_DOMAIN=livekit.example.com

# --- Loop frontend (build-time) ---
# Empty = same-origin API via nginx proxy (recommended)
VITE_API_URL=
VITE_LIVEKIT_URL=wss://livekit.example.com

# --- Loop backend ---
CORS_ORIGINS=https://loop.example.com,https://meetnote.example.com
JWT_SECRET=CHANGE_ME_JWT_SECRET_LONG_RANDOM
JWT_EXPIRES_IN=7d
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_USER=loop
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=loop_db
DB_SYNC=true
LIVEKIT_HOST=http://livekit:7880
LIVEKIT_API_KEY=CHANGE_ME_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LONG_SECRET_AT_LEAST_32_CHARS

# --- MeetNote backend ---
MEETNOTE_FRONTEND_URL=https://meetnote.example.com
MEETNOTE_JWT_SECRET=CHANGE_ME_MEETNOTE_JWT_SECRET
GEMINI_API_KEY=CHANGE_ME_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://meetnote-api.example.com/calendar/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
LOOP_RECORDINGS_PATH=/srv/recordings

# --- MeetNote service account used by Loop (create this user in MeetNote) ---
MEETNOTE_SERVICE_EMAIL=loop-service@example.com
MEETNOTE_SERVICE_PASSWORD=CHANGE_ME_SERVICE_PASSWORD

# --- Shared ---
HTTP_PORT=80
HTTPS_PORT=443
LOOP_RECORDINGS_HOST_PATH=/srv/recordings
MEETNOTE_DATA_HOST_PATH=/srv/meetnote
MYSQL_DATA_HOST_PATH=/srv/mysql
BACKEND_IMAGE=loop-backend:gcp
FRONTEND_IMAGE=loop-web:gcp
MEETNOTE_BACKEND_IMAGE=meetnote-backend:gcp
MEETNOTE_FRONTEND_IMAGE=meetnote-web:gcp
